# Copy to supabase/functions/.env for local development.
# In a hosted project set it with: npx supabase secrets set PIN_AUTH_SECRET=...
#
# Server-only secret (>= 32 chars) used to derive each account's Supabase Auth
# password. Rotating it requires re-deriving every user's auth password.
PIN_AUTH_SECRET=

# Optional: comma-separated browser origins allowed to call pin-login.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
