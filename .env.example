# Copy to `.env` and fill in values from your Supabase project
# (Project Settings → API). Never commit `.env`.

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. This key is safe for the browser because
# Row Level Security enforces access. NEVER put the service-role key or
# any AI provider key in a VITE_ variable — those are bundled into the client.
VITE_SUPABASE_ANON_KEY=
